# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/bamas_f2
# Generate with openssl rand -hex 32.
BETTER_AUTH_SECRET=
# Public environments require HTTPS and real SMTP credentials.
BETTER_AUTH_URL=http://localhost:3000
# Local Mailpit capture; binds to loopback, never sends outside the machine.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=accounts@bamas.example
# Only allowed when BOTH the app origin and SMTP host are loopback.
# For any public hostname set false and provide authenticated SMTP with TLS.
SMTP_ALLOW_INSECURE_LOCAL=true
