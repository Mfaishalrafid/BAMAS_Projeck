# Copy to .env and provide your LOCAL PostgreSQL connection. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/bamas_f2
# Generate at least 32 random bytes; do not use this placeholder.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Permitted only for localhost, 127.0.0.1 or [::1]. Never for a public hostname.
AUTH_ALLOW_UNVERIFIED_LOCAL=true
